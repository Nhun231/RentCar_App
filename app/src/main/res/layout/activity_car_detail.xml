<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true"
    android:paddingTop="@dimen/activity_top_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Car Image Carousel -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="@android:color/white">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerCarImages"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Navigation Arrows -->
            <ImageButton
                android:id="@+id/btnPreviousImage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="Previous image"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnNextImage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_next"
                android:contentDescription="Next image"
                android:visibility="gone" />

            <!-- Image Indicator Dots -->
            <LinearLayout
                android:id="@+id/layoutImageIndicators"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Car Basic Info Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Car Name -->
                <TextView
                    android:id="@+id/tvCarName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Car Name"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="8dp" />

                <!-- Rating and Rides Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/btn_star_big_on"
                        android:tint="#FF9800"
                        android:contentDescription="Rating" />

                    <TextView
                        android:id="@+id/tvRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0"
                        android:textSize="14sp"
                        android:textColor="#FF9800"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="16dp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_agenda"
                        android:tint="#666666"
                        android:contentDescription="Rides" />

                    <TextView
                        android:id="@+id/tvNoOfRides"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 rides"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginStart="6dp" />

                </LinearLayout>

                <!-- Price -->
                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="500K /day"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#26C281"
                    android:layout_marginBottom="12dp" />

                <!-- Location -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_mylocation"
                        android:tint="#666666"
                        android:contentDescription="Location" />

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Location"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

                <!-- Status -->
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVAILABLE"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#26C281"
                    android:background="#E8F5E9"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Booking Info Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#F9F9F9">

                <!-- Pick-up Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pick-up Time"
                        android:textSize="14sp"
                        android:textColor="#666666" />

                    <TextView
                        android:id="@+id/tvPickUpTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="08/11/2025 12:00"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black" />

                </LinearLayout>

                <!-- Drop-off Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Drop-off Time"
                        android:textSize="14sp"
                        android:textColor="#666666" />

                    <TextView
                        android:id="@+id/tvDropOffTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="08/11/2025 14:00"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black" />

                </LinearLayout>

                <!-- Availability Message -->
                <LinearLayout
                    android:id="@+id/layoutAvailability"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    android:background="@android:color/transparent">

                    <ImageView
                        android:id="@+id/ivAvailabilityIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/checkbox_on_background"
                        android:tint="#26C281"
                        android:contentDescription="Available" />

                    <TextView
                        android:id="@+id/tvAvailabilityMessage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="This car is available to rent now"
                        android:textSize="14sp"
                        android:textColor="#26C281"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

                <!-- Rent Now Button -->
                <Button
                    android:id="@+id/btnRentNow"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="RENT NOW"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/button_register_background"
                    android:stateListAnimator="@null" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:background="@android:color/white"
            app:tabMode="scrollable"
            app:tabIndicatorColor="#26C281"
            app:tabSelectedTextColor="#26C281"
            app:tabTextColor="#666666"
            app:tabIndicatorHeight="3dp" />

        <!-- ViewPager for Tab Content -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>

