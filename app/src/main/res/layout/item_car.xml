<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="12dp"
    android:elevation="2dp"
    app:cardCornerRadius="16dp"
    app:cardUseCompatPadding="false"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Car Image Section with Rounded Top Corners -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@android:color/white">

            <ImageView
                android:id="@+id/ivCarImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#E0E0E0"
                android:contentDescription="Car image"
                android:clipToOutline="true" />

            <!-- Image Overlays -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <!-- Quick Booking Badge (Top Left) -->
                <ImageView
                    android:id="@+id/ivQuickBooking"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:tint="#FFD700"
                    android:visibility="gone"
                    android:contentDescription="Quick booking" />

                <!-- Spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Favorite Icon (Top Right) -->
                <ImageView
                    android:id="@+id/ivFavorite"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/btn_star_big_off"
                    android:tint="@android:color/white"
                    android:background="#40000000"
                    android:padding="6dp"
                    android:contentDescription="Favorite" />

            </LinearLayout>

            <!-- Discount Badge (Bottom Right) -->
            <TextView
                android:id="@+id/tvDiscount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:background="@drawable/badge_orange"
                android:text="17% Off"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Car Details Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- No Deposit Badge -->
            <TextView
                android:id="@+id/tvNoDeposit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_green"
                android:text="No deposit"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <!-- Car Model and Year -->
            <TextView
                android:id="@+id/tvCarName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HONDA CITY RS"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginBottom="4dp" />

            <!-- Specifications Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvTransmission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Automatic"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:drawableStart="@android:drawable/ic_menu_manage"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:background="#CCCCCC"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tvSeats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 seats"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:drawableStart="@android:drawable/ic_menu_myplaces"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:background="#CCCCCC"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tvFuelType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gasoline"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:drawableStart="@android:drawable/ic_menu_recent_history"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical" />

            </LinearLayout>

            <!-- Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    android:tint="#666666"
                    android:contentDescription="Location" />

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Phường Hiệp Bình Chánh, Quận Thủ Đức"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <!-- Rating and Trips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/btn_star_big_on"
                    android:tint="#FF9800"
                    android:contentDescription="Rating" />

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5.0"
                    android:textSize="12sp"
                    android:textColor="#FF9800"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_agenda"
                    android:tint="#666666"
                    android:layout_marginStart="12dp"
                    android:contentDescription="Trips" />

                <TextView
                    android:id="@+id/tvRides"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14 rides"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <!-- Price Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#F5F5F5"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Original Price (Strikethrough) -->
                    <TextView
                        android:id="@+id/tvOriginalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="810K"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:visibility="gone" />

                    <!-- Current Price -->
                    <TextView
                        android:id="@+id/tvPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="690K /day"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#26C281" />

                </LinearLayout>

                <!-- Hourly Package Price -->
                <TextView
                    android:id="@+id/tvHourlyPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="486K 4-hour package"
                    android:textSize="12sp"
                    android:textColor="#2196F3"
                    android:drawableStart="@android:drawable/ic_menu_recent_history"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
