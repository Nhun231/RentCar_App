<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <!-- Icon Cảnh báo -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_warning_circle"
            app:tint="@color/rating_stars"
            android:contentDescription="@string/content_description_warning_icon" />

        <!-- Tiêu đề Xác nhận -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/dialog_title_are_you_sure"
            android:textColor="@color/text_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Nội dung Mô tả -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/dialog_msg_change_car_status"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Container Chứa các nút -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Nút YES -->
            <Button
                android:id="@+id/btn_confirm_yes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/btn_yes_change_it"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@color/white" />

            <!-- Nút NO -->
            <Button
                android:id="@+id/btn_confirm_no"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/btn_no_keep_it"
                android:backgroundTint="@color/gray_300"
                android:textColor="@color/text_dark" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>